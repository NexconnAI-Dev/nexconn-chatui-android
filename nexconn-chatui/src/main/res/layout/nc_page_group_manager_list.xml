<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nc_auxiliary_background_1_color"
    android:orientation="vertical">

    <ai.nexconn.chatui.widget.component.HeadComponent
        android:id="@+id/nc_head_component"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nc_title_bar_height"
        app:head_title_text="@string/nc_group_managers" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/nc_margin_size_12" />

    <ai.nexconn.chatui.widget.SettingItemView
        android:id="@+id/siv_group_add_manager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nc_title_bar_height"
        android:layout_marginStart="@dimen/nc_margin_size_16"
        android:layout_marginEnd="@dimen/nc_margin_size_16"
        app:item_content="@string/nc_group_add_manager"
        app:item_divider="true"
        app:item_image="?attr/nc_group_manage_add_member_img"
        app:item_value_text_size="14sp" />


    <ai.nexconn.chatui.usermanage.component.ContactListComponent
        android:id="@+id/nc_group_list_component"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_divider="false"
        app:show_item_remove_button="true"
        app:show_item_right_arrow="false"
        app:show_item_right_text="false"
        app:show_item_select_icon="false"
        app:show_side_bar="false" />

</LinearLayout>