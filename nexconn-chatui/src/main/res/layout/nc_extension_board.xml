<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/nc_ext_attached_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
    </RelativeLayout>

    <View
        android:id="@+id/nc_ext_input_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nc_divider_height"
        android:background="?attr/nc_line_background_color"/>

    <RelativeLayout
        android:id="@+id/nc_ext_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/nc_ext_board_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nc_extension_board_height"
        android:visibility="gone" />
</LinearLayout>