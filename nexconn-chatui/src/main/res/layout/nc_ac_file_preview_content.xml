<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nc_ac_layout_preview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:theme="@style/NCLivelyLightTheme">

    <LinearLayout
        android:id="@+id/nc_ac_ll_download_file_detail_info"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="68dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nc_ac_iv_file_type_image"
            android:layout_width="@dimen/nc_file_preview_image_size"
            android:layout_height="@dimen/nc_file_preview_image_size"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/nc_ac_tv_file_name"
            style="@style/TextStyle.Alignment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/nc_file_preview_name_margin_top"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?attr/nc_text_primary_color"
            android:textSize="@dimen/nc_file_preview_name_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/nc_ac_tv_file_size"
        style="@style/TextStyle.Alignment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/nc_file_preview_margin_bottom"
        android:layout_marginTop="@dimen/nc_file_preview_margin_top"
        android:textColor="?attr/nc_text_secondary_color"
        android:textSize="@dimen/nc_file_preview_size" />

