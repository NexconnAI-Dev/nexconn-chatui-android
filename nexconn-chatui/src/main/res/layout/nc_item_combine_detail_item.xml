<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nc_combine_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/nc_text_primary_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nc_combine_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/nc_text_secondary_color"
            android:textSize="12sp" />

    </LinearLayout>


    <TextView
        android:id="@+id/nc_combine_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/nc_text_primary_color"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/nc_combine_item_image"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_marginTop="6dp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/nc_combine_item_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nc_combine_item_voice_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/nc_voice_receive_play1" />

        <TextView
            android:id="@+id/nc_combine_item_voice_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="?attr/nc_text_primary_color"
            android:textSize="14sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/nc_combine_item_video"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nc_combine_item_video_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF1A1A1A"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/nc_ic_sight_play" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/nc_combine_item_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nc_combine_item_file_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:src="@drawable/nc_lively_file_file" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nc_combine_item_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="?attr/nc_text_primary_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/nc_combine_item_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/nc_text_secondary_color"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:background="?attr/nc_line_background_color" />

</LinearLayout>
