<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nc_auxiliary_background_1_color"
    android:orientation="vertical">

    <ai.nexconn.chatui.widget.component.HeadComponent
        android:id="@+id/nc_head_component"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nc_title_bar_height"
        app:head_title_text="@string/nc_search_friends" />

    <ai.nexconn.chatui.widget.component.SearchComponent
        android:id="@+id/nc_search_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ai.nexconn.chatui.widget.component.ListComponent
        android:id="@+id/nc_list_component"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>